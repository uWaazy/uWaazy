{
  "rewrites": [
    {
      "source": "/readme.svg",
      "destination": "/api/readme"
    },
    {
      "source": "/nuvio/:path*",
      "destination": "/api/nuvio?p=:path*"
    },
    {
      "source": "/api/nuvio/:path*",
      "destination": "/api/nuvio?p=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network-access=(), loopback-network=(), local-network=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/api/readme",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=30, stale-while-revalidate=30, must-revalidate"
        }
      ]
    },
    {
      "source": "/readme.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=30, stale-while-revalidate=30, must-revalidate"
        }
      ]
    }
  ]
}
