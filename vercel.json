{
  "rewrites": [
    { "source": "/readme.svg", "destination": "/api/readme" },
    { "source": "/stremio/manifest.json", "destination": "/api/simkl?stremio=manifest" },
    { "source": "/stremio/subtitles/:type/:id*", "destination": "/api/simkl?stremio=subtitles&type=:type&id=:id*" },
    { "source": "/stremio/:path*", "destination": "/api/simkl?stremio=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "local-network-access=(), loopback-network=(), local-network=()" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/readme.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=8, stale-while-revalidate=25" }] }
  ]
}
