{
  "rewrites": [
    { "source": "/readme.svg", "destination": "/api/readme" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/readme.svg", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }] }
  ]
}
